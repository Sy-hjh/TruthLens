# This release needs no cloud API key and does not automatically read .env.
# Optional values may be set in PyCharm's Run Configuration environment:
# HF_HOME=./runtime/cache
# HF_HUB_DOWNLOAD_TIMEOUT=120
# The listen address/port are command-line options: python run.py --host 127.0.0.1 --port 8010
# Do not store passwords, API keys, or private contacts in a public repository.
